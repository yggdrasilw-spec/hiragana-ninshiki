# Preserve exact bytes used by dictionary source and delivery hashes.
/whitelist.csv text eol=lf
/data/japan-places/** text eol=lf
/data/shiritori-delivery/** text eol=lf
/data/dictionary-imports/2026-10-27-japan-geography.* text eol=lf
/data/dictionary-imports/japan-geography-sources/** text eol=lf

/data/dictionary-imports/2026-10-28-glossary.* text eol=lf
/data/dictionary-imports/glossary-sources/*.json text eol=lf
/data/dictionary-imports/glossary-sources/ipsj-wordlist.csv -text whitespace=cr-at-eol

# Intake hashes and JSONL catalogs require stable line endings.
/data/dictionary-imports/2026-10-28-* text eol=lf
/data/science/*.jsonl text eol=lf
/data/science/*.tsv text eol=lf
/data/entrance-geohistory/*.jsonl text eol=lf

# Source snapshots and intake hashes require stable LF bytes.
/data/geohistory5000/** text eol=lf
/data/dictionary-imports/2026-10-29-geohistory5000.* text eol=lf
