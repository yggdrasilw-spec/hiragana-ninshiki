/data/lexical-expansion/*-candidates.jsonl
/data/lexical-expansion/named-seed-exclusions.json

# Rebuildable multi-source discovery data; keep reports and editorial decisions.
/data/vocabulary-gap/sources/
/data/vocabulary-gap/candidates.sqlite3*
/data/vocabulary-gap/queue.jsonl

# Intermediate definition drafts are rebuilt from pinned source data and editorial TSVs.
